{
  "name": "magic-parser",
  "version": "0.1.0",
  "description": "Render Markdown into beautiful self-contained HTML or PDF, with themable paper styles.",
  "type": "module",
  "bin": {
    "mdp": "bin/mdp.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "example": "node bin/mdp.js build examples/showcase.md -o examples/out/showcase.html",
    "example:pdf": "node bin/mdp.js build examples/showcase.md -f pdf -o examples/out/showcase.pdf"
  },
  "license": "MIT",
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.5.0",
    "katex": "^0.16.47",
    "markdown-it": "^15.0.3",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-github-alerts": "^1.0.1",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "puppeteer-core": "^25.14.0"
  }
}
